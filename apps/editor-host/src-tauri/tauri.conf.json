{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Engine",
  "version": "0.1.0",
  "identifier": "com.gameengine2.editor",

  "build": {
    "beforeDevCommand": {
      "cwd": "../../editor",
      "script": "npm start"
    },

    "beforeBuildCommand": {
      "cwd": "../../editor",
      "script": "npm run build"
    },

    "devUrl": "http://localhost:4200",

    "frontendDist": "../../editor/dist/editor/browser"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameEngine2",
        "width": 1600,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all"
  }
}