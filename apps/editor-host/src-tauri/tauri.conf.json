{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Engine",
  "version": "0.1.0",
  "identifier": "com.gameengine2.editor",

  "build": {
    "beforeDevCommand": {
      "cwd": "../../editor",
      "script": "npm start"
    },

    "beforeBuildCommand": {
      "cwd": "../../editor",
      "script": "npm run build"
    },

    "devUrl": "http://localhost:4200",

    "frontendDist": "../../editor/dist/editor/browser"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "GameEngine2",
        "width": 1600,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ws://localhost:4200 ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all"
  }
}