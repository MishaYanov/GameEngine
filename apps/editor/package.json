{
  "name": "editor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve editor",
    "build": "ng build editor --configuration production",
    "watch": "ng build editor --watch --configuration development",
    "test": "ng test editor",
    "start:dev": "ng serve editor --configuration development",
    "start:demo": "ng serve editor --configuration development --open",
    "start:staging": "ng serve editor --configuration staging",
    "start:production": "ng serve editor --configuration production",
    "start:design": "ng serve design --configuration development --open",
    "start:design:staging": "ng serve design --configuration staging --open",
    "build:dev": "ng build editor --configuration development",
    "build:staging": "ng build editor --configuration staging",
    "build:production": "ng build editor --configuration production",
    "check:production": "ng build editor --configuration production --stats-json && node scripts/check-production.mjs",
    "build:design": "ng build design --configuration development",
    "build:design:staging": "ng build design --configuration staging"
  },
  "private": true,
  "packageManager": "npm@10.3.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@tauri-apps/api": "^2.11.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
