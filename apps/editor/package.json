{
	"name": "editor",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "node scripts/design.mjs serve editor",
		"build": "ng build editor --configuration production",
		"watch": "node scripts/design.mjs build editor --watch --configuration development",
		"test": "ng test editor",
		"start:dev": "node scripts/design.mjs serve editor --configuration development",
		"start:demo": "node scripts/design.mjs serve editor --configuration development --open",
		"start:staging": "node scripts/design.mjs serve editor --configuration staging",
		"start:production": "ng serve editor --configuration production",
		"start:design": "node scripts/design.mjs serve design --configuration development --open",
		"start:design:staging": "node scripts/design.mjs serve design --configuration staging --open",
		"build:dev": "node scripts/design.mjs build editor --configuration development",
		"build:staging": "node scripts/design.mjs build editor --configuration staging",
		"build:production": "ng build editor --configuration production",
		"check:production": "ng build editor --configuration production --stats-json && node scripts/check-production.mjs",
		"build:design": "node scripts/design.mjs build design --configuration development",
		"build:design:staging": "node scripts/design.mjs build design --configuration staging",
		"generate:design": "node scripts/design.mjs",
		"test:design-registry": "node --test scripts/design-registry.test.mjs"
	},
	"private": true,
	"packageManager": "npm@10.3.0",
	"dependencies": {
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/forms": "^22.1.0",
		"@angular/platform-browser": "^22.1.0",
		"@angular/router": "^22.1.0",
		"@ngrx/signals": "22.0.1",
		"@tauri-apps/api": "^2.11.1",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^22.1.4",
		"@angular/cli": "^22.1.4",
		"@angular/compiler-cli": "^22.1.0",
		"@tauri-apps/cli": "^2.11.4",
		"axe-core": "^4.14.0",
		"jsdom": "^28.0.0",
		"prettier": "^3.8.1",
		"typescript": "~6.0.2",
		"vitest": "^4.0.8"
	}
}
