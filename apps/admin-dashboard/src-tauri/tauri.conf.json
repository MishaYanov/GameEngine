{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engine Admin",
  "version": "0.1.0",
  "identifier": "com.gameengine.admin",
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run start"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build"
    },
    "devUrl": "http://127.0.0.1:4301",
    "frontendDist": "../dist/admin-dashboard/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Engine Admin",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
